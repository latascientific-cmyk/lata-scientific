# Supabase connection for the customer review system.
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# After editing, regenerate the browser config:
#
#     node scripts/gen-supabase-config.mjs
#
# That writes assets/js/supabase-config.js, which IS committed — the site is
# static and served straight from the repository, so the browser has to be able
# to fetch it. That is fine and intended: the publishable key is a public
# identifier, and Row Level Security decides everything it is allowed to do.
#
# NEVER put the service_role key here. It bypasses Row Level Security
# completely and belongs only in the Supabase dashboard.

SUPABASE_URL=https://yoqdsrwnwcdwzdcyemjl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
